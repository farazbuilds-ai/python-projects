import sys


def fahrenheit(cel):
    return (cel * 9 / 5) + 32


def celsius(fah):
    return (fah - 32) * 5 / 9


print("===== Temperature Converter=====")
print("1. Celsius to Fahrenheit")
print("2. Fahrenheit to Celsius")
print("3. Exit")

while True:
    user = input("\nEnter your choice: ")

    if user == "1":
        cel = float(input("Enter the Celsius Temperature: "))
        print(f"Fahrenheit: {round(fahrenheit(cel), 2)}°F")

    elif user == "2":
        fah = float(input("Enter the Fahrenheit Temperature: "))
        print(f"Celsius: {round(celsius(fah), 2)}°C")

    elif user == "3":
        print("Exiting program...")
        sys.exit()

    else:
        print("Invalid Choice!") 
 
